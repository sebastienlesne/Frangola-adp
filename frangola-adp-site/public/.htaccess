<IfModule mod_headers.c>
  # index.html ne doit JAMAIS être mis en cache : c'est lui qui indique
  # au navigateur quelle version du code charger.
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Le code compilé porte une empreinte unique dans son nom : il peut être
  # gardé un an sans risque, un changement de version change le nom du fichier.
  <FilesMatch "\.(js|css|woff2|woff|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images : une semaine, suffisant sans bloquer une mise à jour de logo.
  <FilesMatch "\.(png|jpg|jpeg|gif|svg|ico|webp)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
